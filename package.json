{
  "name": "keib",
  "version": "1.0.0",
  "description": "KEIB 競馬予想 — ブラウザで動く競馬予想ソフト（指数・展開予想・モンテカルロ・期待値・バックテスト）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && npm run serve",
    "tunnel": "bash scripts/tunnel.sh",
    "calibrate": "node scripts/calibrate.mjs",
    "test": "node --test",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18"
  }
}
